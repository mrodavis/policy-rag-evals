# Optional. Without it the service and evals use the offline extractive generator.
ANTHROPIC_API_KEY=
RAG_MODEL=claude-sonnet-5-5

# Where the Airflow pipeline writes candidate and promoted index builds.
KB_ARTIFACTS_DIR=./artifacts
KB_CORPUS_DIR=./corpus
KB_GOLDEN_PATH=./evals/golden.yaml

# Optional append-only JSONL log of every answer (questions are logged after redaction).
DECISION_LOG_PATH=
